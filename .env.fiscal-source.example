# Copia a .env.fiscal-source (gitignored). Solo lectura — copia embeddings a local.
# Obtener URL desde Render → marfyl-backend → Environment → DATABASE_URL (Neon pooled)
# NO commitear este archivo con credenciales reales.

FISCAL_KNOWLEDGE_SOURCE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
AGENT_SECRET=shared-secret-with-nestjs
USE_PYTHON_AGENT=true
PYTHON_AGENT_URL=http://localhost:8000